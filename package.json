{
  "name": "one-settings",
  "displayName": "One Settings",
  "version": "0.1.19",
  "publisher": "wdomitrz",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/wdomitrz/one_settings"
  },
  "engines": { "vscode": "^1.100.0" },
  "main": "./extension.js",
  "browser": "./extension.js",
  "extensionKind": ["ui"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "oneSettings.keybindings": {
          "type": "array",
          "scope": "application",
          "description": "Replaces Default-profile keybindings on startup or changes to this User setting. Unset leaves the file alone; [] clears it.",
          "items": { "type": "object" }
        }
      }
    }
  }
}
